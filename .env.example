# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par git — aucune de ces valeurs ne doit être commitée.
#
# Les trois premières se trouvent dans le tableau de bord Supabase,
# section Settings → API.

# URL du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publiable. Incluse dans le bundle navigateur, c'est prévu : la RLS est ce
# qui protège les données, pas le secret de cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Clé de service — CONTOURNE LA RLS, donne accès à toutes les organisations.
# Réservée aux webhooks et aux tâches planifiées, jamais importée depuis un
# composant client. Si elle fuite, la révoquer immédiatement dans le tableau de
# bord : la faire disparaître d'un dépôt ne suffit pas, l'historique la garde.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Source des données : `supabase` pour la vraie base, `mock` pour le jeu de
# démonstration en mémoire (utile pour développer l'interface hors ligne).
# Absente, la valeur vaut `supabase` : une variable oubliée sur l'hébergeur doit
# faire échouer le démarrage, jamais servir des factures inventées.
NEXT_PUBLIC_DATA_SOURCE=supabase
